{
  "title": "FastAuth Dashboard",
  "uid": "fastauth-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Login Attempts (5m rate)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(fastauth_auth_login_attempts_total[5m]))",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "id": 2,
      "title": "Failed Logins (5m rate)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "rate(fastauth_auth_login_attempts_total{success='false'}[5m])",
          "legendFormat": "Failed"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active Sessions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "fastauth_auth_sessions_active",
          "legendFormat": "Active"
        }
      ]
    },
    {
      "id": 4,
      "title": "Brute Force Blocks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "increase(fastauth_auth_brute_force_blocks_total[24h])",
          "legendFormat": "24h Total"
        }
      ]
    },
    {
      "id": 5,
      "title": "Request Latency (P95)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(fastauth_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "{{ path }}"
        }
      ]
    },
    {
      "id": 6,
      "title": "MFA Adoption",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(fastauth_auth_mfa_attempts_total[1h])) by (success)",
          "legendFormat": "{{ success }}"
        }
      ]
    }
  ],
  "time": { "from": "now-1h", "to": "now" }
}
