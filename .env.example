# EXAMPLE configuration file
# Copy this file to .env and update with your actual values

SECRET_KEY=change-me-use-a-long-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=60
REFRESH_TOKEN_EXPIRE_SECONDS=3600

# SQLite (local dev, no migrations)
# DATABASE_URL=sqlite:///fastauth.db

# PostgreSQL (local)
DATABASE_URL=postgresql://example-user:example-pass@localhost:5432/fastauth

# PostgreSQL (hosted with SSL)
# DATABASE_URL=postgresql://example-user:example-pass@host.example.com:5432/fastauth?sslmode=require

# Redis (optional)
REDIS_URL=redis://localhost:6379
